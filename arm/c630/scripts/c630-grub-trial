#!/bin/sh
# Try a new GRUB as the loader the firmware starts, once. The candidate goes to
# both EFI/debian/grubaa64.efi and EFI/BOOT/grubaa64.efi: the 2026-11-19 attempt
# that replaced only EFI/BOOT never ran the candidate, so the firmware starts
# EFI/debian (not confirmed by any other means; efivars are unreadable here).
#
#   c630-grub-trial <ver>      install /boot/efi/EFI/grubtest/grub-<ver>.efi in
#                              both places and arm one attempt
#   c630-grub-trial --again    arm one more attempt with the GRUB already installed
#   c630-grub-trial --keep     remove the guard: the installed GRUB boots the menu
#                              itself on every boot. GRUB 2.12 stays in EFI/c630/
#                              and c630-menu lists it as c630-grub212.
#   c630-grub-trial --restore  put GRUB 2.12 back and remove the guard
#   c630-grub-trial --status   show what is installed and the last result
#
# The shim is not changed. The stubs (EFI/debian/grub.cfg, EFI/BOOT/grub.cfg) get a
# guard: a candidate GRUB (2.14 or later, it sets feature_gcry_hw_accel) boots the
# menu itself only while c630_try=1 in grubenv, and clears that first. On every
# other boot it chainloads the working 2.12 kept at EFI/c630/grubaa64-2.12.efi. So a
# black screen costs one power cycle (hold power 10 s), as long as the candidate
# can still start 2.12. If it cannot: RECOVERY.md section 3 (installer stick).
#
# An armed attempt boots c630-grubtest-kernel (default kernel, verbose) and leaves
# a trail in c630_gt. Read it with: c630-menu --grubtest-result
set -e

U=a81deabf-0654-4f68-b795-284305d26f13
ESP=3BA7-7161
E=/boot/efi/EFI
OLD=$E/c630/grubaa64-2.12.efi   # GRUB 2.12 from the stick: the fallback
LIVE="$E/debian/grubaa64.efi $E/BOOT/grubaa64.efi"
OLD_SHA=3db6ed77b8de1677708189f8bac0fffdf0abb3b7886039231aa8a4acac8e0c22
ENV=/boot/grub/grubenv

case "$1" in -h|--help|"") sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;; esac
[ "$(id -u)" = 0 ] || { echo "run as root" >&2; exit 1; }
[ "$(findmnt -no UUID /boot/efi)" = "$ESP" ] || { echo "/boot/efi is not $ESP" >&2; exit 1; }

sha() { sha256sum "$1" | cut -d' ' -f1; }

stub() {  # $1 = file, $2 = label, $3 = candidate version, or empty for no guard
  t=$(mktemp)
  cat > "$t" <<EOF
search.fs_uuid $U root
set prefix=(\$root)'/boot/grub'
set c630_from="$2"
export c630_from
EOF
  [ -n "$3" ] && cat >> "$t" <<EOF
# Guard written by c630-grub-trial. Only a candidate GRUB runs this block.
if test "\$feature_gcry_hw_accel" = "y"; then
  set c630_go=
  set c630_try=
  load_env c630_try
  if test "\$c630_try" = "1"; then
    set c630_try=0
    set c630_gt="$3 direct: 0-stub-read"
    if save_env c630_try c630_gt; then
      set c630_go=1
    fi
  fi
  if test "\$c630_go" != "1"; then
    echo "GRUB $3: no attempt armed. Starting GRUB 2.12."
    set c630_fb=1
    save_env c630_fb
    search.fs_uuid $ESP root
    chainloader /EFI/c630/grubaa64-2.12.efi
    boot
  fi
fi
EOF
  echo "configfile \$prefix/c630.cfg" >> "$t"
  grub-script-check "$t"
  cp "$t" "$1"
  cmp "$t" "$1"
  rm -f "$t"
}

flush() {
  sync
  fsfreeze -f / && fsfreeze -u /    # GRUB cannot replay the ext4 journal
  sync
}

status() {
  for f in $E/debian/shimaa64.efi $E/BOOT/BOOTAA64.EFI $LIVE $OLD; do
    [ -f "$f" ] || { echo "missing           $f"; continue; }
    echo "$(sha "$f" | cut -c1-16)  $(strings -n 5 "$f" | grep -m1 -E '^2\.[0-9]+[-~]') $f"
  done
  grep -c feature_gcry_hw_accel $E/debian/grub.cfg | sed 's/^/guard lines in EFI\/debian\/grub.cfg: /'
  grub-editenv $ENV list | grep -E '^c630_(try|gt|fb)=' || echo "no c630_try/c630_gt/c630_fb in grubenv"
}

arm() {
  grep -q -- '--id c630-grubtest-kernel ' /boot/grub/c630.cfg || { echo "c630.cfg has no c630-grubtest-kernel entry; run c630-menu" >&2; exit 1; }
  grub-editenv $ENV unset c630_gt
  grub-editenv $ENV unset c630_fb
  grub-editenv $ENV set c630_try=1
}

case "$1" in
--status)
  status ;;
--again)
  grep -q feature_gcry_hw_accel $E/debian/grub.cfg || { echo "no guard installed; nothing to arm" >&2; exit 1; }
  arm; flush; status ;;
--keep)
  [ "$(sha $OLD)" = "$OLD_SHA" ] || { echo "$OLD is not the stick's GRUB 2.12; keeping the guard" >&2; exit 1; }
  grub-editenv $ENV list | grep -q '^c630_gt=.* direct: .* 7-boot$' || { echo "no completed direct attempt in c630_gt; keeping the guard" >&2; exit 1; }
  stub $E/debian/grub.cfg "sda2 EFI/debian" ""
  stub $E/BOOT/grub.cfg "sda2 EFI/BOOT" ""
  for v in c630_try c630_gt c630_fb; do grub-editenv $ENV unset $v; done
  c630-menu
  flush; status ;;
--restore)
  [ "$(sha $OLD)" = "$OLD_SHA" ] || { echo "$OLD is not the stick's GRUB 2.12" >&2; exit 1; }
  for f in $LIVE; do cp $OLD "$f"; cmp $OLD "$f"; done
  stub $E/debian/grub.cfg "sda2 EFI/debian" ""
  stub $E/BOOT/grub.cfg "sda2 EFI/BOOT" ""
  grub-editenv $ENV unset c630_try
  flush; status ;;
*)
  new=$E/grubtest/grub-$1.efi
  [ -f "$new" ] || { echo "no $new" >&2; exit 1; }
  if [ ! -f $OLD ]; then   # first run: keep the 2.12 that is in place now
    for f in $LIVE; do [ "$(sha "$f")" = "$OLD_SHA" ] && { mkdir -p $E/c630; cp "$f" $OLD; break; }; done
  fi
  [ -f $OLD ] && [ "$(sha $OLD)" = "$OLD_SHA" ] || { echo "no copy of the stick's GRUB 2.12 for $OLD; not touching anything" >&2; exit 1; }
  # Guard first, loader second: at no point does an unguarded candidate boot.
  stub $E/debian/grub.cfg "sda2 EFI/debian" "$1"
  stub $E/BOOT/grub.cfg "sda2 EFI/BOOT" "$1"
  for f in $LIVE; do cp "$new" "$f"; cmp "$new" "$f"; done
  arm; flush; status ;;
esac

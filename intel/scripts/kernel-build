#!/usr/bin/env bash
# kernel-build — pull the latest mainline kernel, build it, and install it.
#
# Usage: kernel-build [--no-pull] [--no-install] [--reboot]
#   --no-pull     build the tree as it is, skip git pull
#   --no-install  build only; skip modules_install/install
#   --reboot      reboot once the install finishes
#
# Env: KSRC (default ~/linux), JOBS (default nproc)
#
# Every build is stamped with a fresh build ID in uname -v
# ("#<n>-<id> SMP ..."). The install is recorded in
# $STATE_DIR/installed; kernel-boot-check compares the running kernel to it.
#
# arm64 (the Windows-on-ARM laptops in arm/): `make install` leaves only
# /boot/vmlinux-<rel>, so the Image is also copied to /boot/vmlinuz-<rel> and
# the DTBs go to /usr/lib/linux-image-<rel>/ (Debian's layout). If c630-menu
# is installed it regenerates /boot/grub/c630.cfg. The default boot entry is
# never changed there: boot the new build once with c630-menu --once.
set -euo pipefail

KSRC=${KSRC:-$HOME/linux}
JOBS=${JOBS:-$(nproc)}
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/kernel-build
PULL=1 INSTALL=1 REBOOT=0

for arg in "$@"; do
  case $arg in
    --no-pull)    PULL=0 ;;
    --no-install) INSTALL=0 ;;
    --reboot)     REBOOT=1 ;;
    -h|--help)    sed -n '2,8p' "$0"; exit 0 ;;
    *) echo "unknown option: $arg" >&2; exit 2 ;;
  esac
done

if [[ ! -d $KSRC/.git ]]; then
  echo "cloning mainline into $KSRC"
  git clone https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git "$KSRC"
  PULL=0
fi
cd "$KSRC"

if (( PULL )); then
  git pull --ff-only
fi
echo "source: $(git describe --tags)"

# Start from the existing .config, or the running kernel's config on a fresh tree.
if [[ ! -f .config ]]; then
  cp "/boot/config-$(uname -r)" .config
  # Debian configs point at signing keys that are not on this machine.
  scripts/config --set-str SYSTEM_TRUSTED_KEYS "" --set-str SYSTEM_REVOCATION_KEYS ""
  scripts/config --set-str LOCALVERSION "-mainline"
fi
make olddefconfig

# Build ID: the kernel's own build counter plus 8 random hex digits, so two
# builds of the same commit and release still differ in uname -v. A new ID
# changes init/version.o, which forces vmlinux to relink.
n=$(( $(cat .version 2>/dev/null || echo 0) + 1 ))
echo "$n" > .version
build_id=$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')
export KBUILD_BUILD_VERSION="$n-$build_id"

start=$(date +%s)
make -j"$JOBS"
release=$(make -s kernelrelease)
uts=$(sed -n 's/^#define UTS_VERSION "\(.*\)"$/\1/p' include/generated/utsversion.h)
if [[ $uts != "#$KBUILD_BUILD_VERSION "* ]]; then
  echo "build ID $KBUILD_BUILD_VERSION missing from UTS_VERSION '$uts'" >&2
  exit 1
fi
echo "built $release in $(( $(date +%s) - start ))s"
echo "uname -v will read: $uts"

record() {   # record <file>: what was built, for kernel-boot-check
  mkdir -p "$STATE_DIR"
  {
    echo "RELEASE=$release"
    echo "UTS_VERSION=$uts"
    echo "BUILD_ID=$KBUILD_BUILD_VERSION"
    echo "SOURCE=$(git describe --tags)"
    echo "COMMIT=$(git rev-parse HEAD)"
    echo "DATE=$(date -Iseconds)"
  } >"$STATE_DIR/$1"
}
record built

# Point a pinned GRUB_DEFAULT ("...gnulinux-<release>-advanced-<uuid>") at the
# new release, so the build just installed is the one that boots. A numeric or
# "saved" GRUB_DEFAULT is left alone.
set_grub_default() {
  local conf=/etc/default/grub cur new id backup tmp
  cur=$(sed -n 's/^GRUB_DEFAULT=["'\'']\{0,1\}\([^"'\'']*\)["'\'']\{0,1\}$/\1/p' "$conf")
  if [[ ! $cur =~ ^(.*gnulinux-)(.+)(-advanced-[0-9a-fA-F-]+)$ ]]; then
    echo "GRUB_DEFAULT='$cur' is not pinned to a release; left as is"
    return 0
  fi
  new="${BASH_REMATCH[1]}$release${BASH_REMATCH[3]}"
  id=${new##*>}
  if [[ $new == "$cur" ]]; then
    echo "GRUB_DEFAULT already boots $release"
    return 0
  fi
  backup="$conf.kernel-build-$(date +%Y%m%d-%H%M%S)"
  tmp=$(mktemp)
  awk -v v="$new" '/^GRUB_DEFAULT=/ { print "GRUB_DEFAULT=\"" v "\""; next } { print }' "$conf" >"$tmp"
  sudo cp -p "$conf" "$backup"
  sudo cp "$tmp" "$conf"
  rm -f "$tmp"
  sudo update-grub
  if sudo grep -qF "'$id'" /boot/grub/grub.cfg; then
    echo "GRUB_DEFAULT now boots $release (backup: $backup)"
  else
    echo "no GRUB entry '$id'; restoring $backup" >&2
    sudo cp -p "$backup" "$conf"
    sudo update-grub
    return 1
  fi
}

# DKMS modules registered on this machine, one name/version per line.
dkms_modules() {
  local dkms
  dkms=$(PATH=$PATH:/usr/sbin:/sbin command -v dkms) || return 0
  sudo "$dkms" status 2>/dev/null |
    sed -n 's|^\([^/,: ]\{1,\}/[^,: ]\{1,\}\)[,:].*|\1|p' | sort -u
}

# `make install` exports KERNELRELEASE into the /etc/kernel/postinst.d hooks;
# the dkms hook inherits it and NVIDIA's Makefile fails, which stops run-parts
# before the initramfs and grub hooks. With DKMS modules present, install by
# hand and run every tool in a clean environment.
install_kernel() {
  local mods m flag
  local E=(env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root)
  mapfile -t mods < <(dkms_modules)
  if (( ${#mods[@]} == 0 )); then
    sudo make install        # Debian installkernel: initramfs + update-grub
    return
  fi
  echo "DKMS modules ${mods[*]}: installing in a clean environment"
  sudo cp arch/x86/boot/bzImage "/boot/vmlinuz-$release"
  sudo cp System.map "/boot/System.map-$release"
  sudo cp .config "/boot/config-$release"
  for m in "${mods[@]}"; do
    # build --force first: install --force alone reuses a cached build.
    sudo "${E[@]}" dkms build "$m" -k "$release" --force
    sudo "${E[@]}" dkms install "$m" -k "$release" --force
  done
  flag=-c
  [[ -e /boot/initrd.img-$release ]] && flag=-u
  sudo "${E[@]}" update-initramfs "$flag" -k "$release"
  sudo "${E[@]}" update-grub
}

# arm64: add what `make install` leaves out, then rebuild the C630 boot menu.
# c630.cfg is what the C630 firmware boots, not grub.cfg; its default is
# pinned in /etc/default/c630-menu and is not touched here.
install_arm64_extras() {
  local menu
  sudo cp arch/arm64/boot/Image "/boot/vmlinuz-$release"
  sudo make INSTALL_DTBS_PATH="/usr/lib/linux-image-$release" dtbs_install
  menu=$(PATH=$PATH:/usr/local/sbin:/usr/sbin command -v c630-menu) || {
    # The distro hook ran update-grub before vmlinuz-<rel> existed, so menu
    # generators that list /boot/vmlinuz-* (09_galaxy-book-go) missed this
    # build. Run it again; the default entry is not changed.
    echo "no c630-menu; running update-grub again now that vmlinuz-$release exists"
    sudo update-grub
    return 0
  }
  sudo "$menu"
  sudo grub-script-check /boot/grub/c630.cfg
  if ! sudo grep -qF -- "--id c630-$release " /boot/grub/c630.cfg; then
    echo "c630.cfg has no entry c630-$release" >&2
    return 1
  fi
  echo "c630.cfg has c630-$release; boot it once with: sudo c630-menu --once c630-$release"
}

# Does the image in /boot carry this build's version string? The x86 bzImage
# header has it where file(1) reads it; the arm64 Image is uncompressed.
boot_image_is_this_build() {
  local img=/boot/vmlinuz-$release
  if [[ $ARCH == arm64 ]]; then
    sudo grep -aqF -- "$uts" "$img"
  else
    file -bL "$img" | grep -qF -- "$uts"
  fi
}

case $(uname -m) in aarch64) ARCH=arm64 ;; *) ARCH=x86 ;; esac

if (( INSTALL )); then
  # Stripped modules keep .BTF but drop DWARF: the initrd is ~90MB, not ~640MB.
  sudo make -j"$JOBS" INSTALL_MOD_STRIP=1 modules_install
  if [[ $ARCH == arm64 ]]; then
    sudo make install
    install_arm64_extras
  else
    install_kernel
    set_grub_default
  fi
  if ! boot_image_is_this_build; then
    echo "/boot/vmlinuz-$release is not build $KBUILD_BUILD_VERSION" >&2
    exit 1
  fi
  record installed
  echo "installed $release, build $KBUILD_BUILD_VERSION"
  if (( REBOOT )); then
    sudo systemctl reboot
  fi
else
  echo "not installed (--no-install)"
fi

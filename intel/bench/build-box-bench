#!/bin/bash
# Measure the build box: empty system call cost, then three timed clean
# tinyconfig builds of ~/linux HEAD (exported to a temp dir; ~/linux is untouched).
# Usage: build-box-bench          env: LINUX=~/linux  JOBS=$(nproc)
set -euo pipefail
[[ ${1:-} == -h ]] && { sed -n '2,4p' "$0"; exit 0; }
LINUX=${LINUX:-$HOME/linux} JOBS=${JOBS:-$(nproc)}
here=$(dirname "$(readlink -f "$0")") tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
echo "kernel $(uname -r); cmdline: $(cut -d' ' -f3- /proc/cmdline)"
echo "governor $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor); meltdown: $(cat /sys/devices/system/cpu/vulnerabilities/meltdown)"
gcc -O2 -o "$tmp/bench" "$here/getppid-bench.c"
for i in 1 2 3; do "$tmp/bench"; done
mkdir "$tmp/src"; git -C "$LINUX" archive HEAD | tar -x -C "$tmp/src"; cd "$tmp/src"
echo "source $(git -C "$LINUX" log --oneline -1)"
make -s tinyconfig >/dev/null; make -s -j"$JOBS" >/dev/null 2>&1   # warm the cache
for i in 1 2 3; do make -s clean; /usr/bin/time -f "build $i: %e s" make -s -j"$JOBS" >/dev/null 2>"$tmp/err" || { tail "$tmp/err"; exit 1; }; tail -1 "$tmp/err"; done
